import { TabWidget } from "std-widgets.slint";
import { BatchView } from "BatchView.slint";
import { TriageView } from "TriageView.slint";
import { OcrSettingsView } from "OcrSettingsView.slint";
import { ReviewView } from "ReviewView.slint";
import { RegionView } from "RegionView.slint";
import { ColumnOrderDialog } from "ColumnOrderDialog.slint";
import { ExportDialog } from "ExportDialog.slint";

export component MainWindow inherits Window {
    title: "Document Harvester";
    width: 1100px;
    height: 760px;

    in-out property <string> column-order;
    in-out property <[string]> alerts;
    in-out property <bool> show-column-order-dialog;
    in-out property <bool> show-export-dialog;

    TabWidget {
        Tab {
            title: "Batch";
            BatchView { column-order <=> root.column-order; }
        }
        Tab {
            title: "Triage";
            TriageView {}
        }
        Tab {
            title: "OCR";
            OcrSettingsView {}
        }
        Tab {
            title: "Review";
            ReviewView {}
        }
        Tab {
            title: "Region";
            RegionView {
                column-order <=> root.column-order;
                alerts <=> root.alerts;
            }
        }
    }
    if root.show-column-order-dialog: ColumnOrderDialog {
        column-order <=> root.column-order;
    }
    if root.show-export-dialog: ExportDialog {
        outstanding-alerts <=> root.alerts;
    }
}
