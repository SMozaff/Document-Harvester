import { Button, Text, VerticalBox } from "std-widgets.slint";
import { AboutDialog } from "AboutDialog.slint";

export component MainWindow inherits Window {
    title: "Document Harvester";
    preferred-width: 920px;
    preferred-height: 640px;

    in-out property <bool> show-about-dialog: false;

    VerticalBox {
        alignment: center;
        spacing: 16px;

        Text {
            text: "Document Harvester";
            font-size: 30px;
            horizontal-alignment: center;
        }
        Text {
            text: "Digital PDF region capture → one accumulating Excel workbook";
            horizontal-alignment: center;
        }
        Text {
            text: "Desktop shell initialized. Project creation is the next implementation step.";
            horizontal-alignment: center;
        }
        Button {
            text: "About";
            clicked => { root.show-about-dialog = true; }
        }
    }

    if root.show-about-dialog: AboutDialog {
        close => { root.show-about-dialog = false; }
    }
}
