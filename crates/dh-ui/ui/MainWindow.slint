import { Button, LineEdit, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { AboutPanel } from "AboutDialog.slint";

// Two screens plus the About placeholder:
//   project home      -> !project-open: the New Project entry point
//   project workspace -> project-open: the open project and its empty state
//   About             -> reachable from both screens via the About button
//
// Screen choice, enablement and the empty-state text are decided in
// `dh-app/src/navigation.rs`; this file only renders them and reports intent.
export component MainWindow inherits Window {
    title: "Document Harvester";
    preferred-width: 920px;
    preferred-height: 640px;

    in-out property <bool> show-about-dialog: false;
    in-out property <bool> project-open: false;
    in-out property <bool> project-busy: false;
    in-out property <string> project-name: "";
    in-out property <string> parent-directory: "";
    in-out property <string> workbook-path: "";
    in-out property <string> status-message: "Create a project to begin.";
    in-out property <string> empty-state-message: "";
    in-out property <bool> create-project-enabled: false;
    in-out property <string> create-project-note: "Enter a project name and choose a folder.";
    in-out property <bool> import-pdf-enabled: false;
    in-out property <string> import-pdf-note: "PDF import is not available yet.";

    callback choose-parent-directory();
    callback create-project(string, string);
    callback new-project();
    callback project-form-changed(string, string);

    VerticalBox {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "Document Harvester";
            font-size: 30px;
            horizontal-alignment: center;
        }
        Text {
            text: "Digital PDF region capture → one accumulating Excel workbook";
            horizontal-alignment: center;
        }

        // Project home: no project is open.
        if !root.project-open: VerticalBox {
            spacing: 10px;

            Text {
                text: "New Project";
                font-size: 20px;
                horizontal-alignment: center;
            }
            LineEdit {
                text <=> root.project-name;
                placeholder-text: "Project name";
                edited(text) => {
                    root.project-form-changed(text, root.parent-directory);
                }
            }
            HorizontalBox {
                LineEdit {
                    text <=> root.parent-directory;
                    read-only: true;
                    placeholder-text: "Choose where the project folder will be created";
                }
                Button {
                    text: "Browse…";
                    clicked => { root.choose-parent-directory(); }
                }
            }
            Button {
                text: root.project-busy ? "Creating…" : "Create Project";
                enabled: root.create-project-enabled;
                clicked => {
                    root.status-message = "Creating project…";
                    root.create-project(root.project-name, root.parent-directory);
                }
            }
            if !root.create-project-enabled: Text {
                text: root.create-project-note;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Project workspace: a project is open, with no content yet.
        if root.project-open: VerticalBox {
            spacing: 10px;

            Text {
                text: root.project-name;
                font-size: 22px;
                horizontal-alignment: center;
            }
            Text {
                text: "Workbook: " + root.workbook-path;
                wrap: word-wrap;
            }
            Text {
                text: root.empty-state-message;
                horizontal-alignment: center;
            }
            HorizontalBox {
                Button {
                    text: "Import PDF";
                    enabled: root.import-pdf-enabled;
                }
                Text {
                    text: root.import-pdf-note;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
            Button {
                text: "New Project";
                clicked => { root.new-project(); }
            }
        }

        Text {
            text: root.status-message;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        Button {
            text: "About";
            clicked => { root.show-about-dialog = true; }
        }
    }

    if root.show-about-dialog: AboutPanel {
        close => { root.show-about-dialog = false; }
    }
}
