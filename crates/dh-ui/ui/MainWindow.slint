import { Button, LineEdit, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { AboutPanel } from "AboutDialog.slint";
import { ViewerPanel } from "ViewerView.slint";

// Two screens plus the About placeholder:
//   project home      -> !project-open: the New Project entry point
//   project workspace -> project-open: project identity, PDF viewer and empty state
//   About             -> reachable from both screens via the About button
//
// Screen choice, enablement and the empty-state text are decided in
// `dh-app/src/navigation.rs`; this file only renders them and reports intent.
// The viewer never handles PDF data itself: geometry and pixels come from
// dh-app, and every control here reports an intent callback.
export component MainWindow inherits Window {
    title: "Document Harvester";
    preferred-width: 920px;
    preferred-height: 640px;

    in-out property <bool> show-about-dialog: false;
    in-out property <bool> project-open: false;
    in-out property <bool> project-busy: false;
    in-out property <string> project-name: "";
    in-out property <string> parent-directory: "";
    in-out property <string> workbook-path: "";
    in-out property <string> status-message: "Create a project to begin.";
    in-out property <string> empty-state-message: "";
    in-out property <bool> create-project-enabled: false;
    in-out property <string> create-project-note: "Enter a project name and choose a folder.";
    in-out property <bool> import-pdf-enabled: true;
    in-out property <string> import-pdf-note: "";

    // Stage 2 viewer state, supplied by dh-app.
    in-out property <bool> pdf-imported: false;
    in-out property <image> page-image;
    in-out property <string> viewer-status: "";
    in-out property <bool> viewer-busy: false;
    in-out property <int> page-number: 0;
    in-out property <int> page-count: 0;
    in-out property <length> image-x;
    in-out property <length> image-y;
    in-out property <length> image-width;
    in-out property <length> image-height;
    in-out property <length> viewport-width: 0px;
    in-out property <length> viewport-height: 0px;

    callback choose-parent-directory();
    callback create-project(string, string);
    callback new-project();
    callback project-form-changed(string, string);
    callback import-pdf();
    callback previous-page();
    callback next-page();
    callback zoom-in();
    callback zoom-out();
    callback fit-page();
    callback pan(length, length);

    VerticalBox {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "Document Harvester";
            font-size: 30px;
            horizontal-alignment: center;
        }
        Text {
            text: "Digital PDF region capture → one accumulating Excel workbook";
            horizontal-alignment: center;
        }

        // Project home: no project is open.
        if !root.project-open: VerticalBox {
            spacing: 10px;

            Text {
                text: "New Project";
                font-size: 20px;
                horizontal-alignment: center;
            }
            LineEdit {
                text <=> root.project-name;
                placeholder-text: "Project name";
                edited(text) => {
                    root.project-form-changed(text, root.parent-directory);
                }
            }
            HorizontalBox {
                LineEdit {
                    text <=> root.parent-directory;
                    read-only: true;
                    placeholder-text: "Choose where the project folder will be created";
                }
                Button {
                    text: "Browse…";
                    clicked => { root.choose-parent-directory(); }
                }
            }
            Button {
                text: root.project-busy ? "Creating…" : "Create Project";
                enabled: root.create-project-enabled;
                clicked => {
                    root.status-message = "Creating project…";
                    root.create-project(root.project-name, root.parent-directory);
                }
            }
            if !root.create-project-enabled: Text {
                text: root.create-project-note;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        // Project workspace: a project is open. Once a PDF has been imported,
        // the real rendered page replaces the empty state.
        if root.project-open: VerticalBox {
            spacing: 10px;
            vertical-stretch: 1;

            Text {
                text: root.project-name;
                font-size: 22px;
                horizontal-alignment: center;
            }
            Text {
                text: "Workbook: " + root.workbook-path;
                wrap: word-wrap;
            }
            if !root.pdf-imported: Text {
                text: root.empty-state-message + " " + root.import-pdf-note;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.pdf-imported: ViewerPanel {
                page-image <=> root.page-image;
                import-pdf-enabled <=> root.import-pdf-enabled;
                viewer-status <=> root.viewer-status;
                viewer-busy <=> root.viewer-busy;
                page-number <=> root.page-number;
                page-count <=> root.page-count;
                image-x <=> root.image-x;
                image-y <=> root.image-y;
                image-width <=> root.image-width;
                image-height <=> root.image-height;
                viewport-width <=> root.viewport-width;
                viewport-height <=> root.viewport-height;
                import-pdf => { root.import-pdf(); }
                previous-page => { root.previous-page(); }
                next-page => { root.next-page(); }
                zoom-in => { root.zoom-in(); }
                zoom-out => { root.zoom-out(); }
                fit-page => { root.fit-page(); }
                pan(dx, dy) => { root.pan(dx, dy); }
            }
            Button {
                text: "New Project";
                clicked => { root.new-project(); }
            }
        }

        Text {
            text: root.status-message;
            wrap: word-wrap;
            horizontal-alignment: center;
        }

        Button {
            text: "About";
            clicked => { root.show-about-dialog = true; }
        }
    }

    if root.show-about-dialog: AboutPanel {
        close => { root.show-about-dialog = false; }
    }
}
