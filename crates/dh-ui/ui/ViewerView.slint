// Stage 2 page viewer surface and Stage 6 selection overlay host.
//
// This component only renders the page image, displays plain geometry supplied
// by dh-app and reports user intent. It never parses a PDF, converts
// coordinates, or decides which file is open; dh-app supplies geometry derived
// from the canonical PageTransform and supplies the pixels produced by the
// renderer off the UI thread.
import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { RegionOverlay } from "RegionView.slint";

export component ViewerPanel inherits VerticalBox {
    in property <image> page-image;
    in property <bool> import-pdf-enabled: true;
    in property <string> import-pdf-label: "Import PDF";
    in property <string> import-pdf-accessible-label: "Import or replace PDF";
    in property <string> fit-page-label: "Fit page";
    in property <string> zoom-out-label: "−";
    in property <string> zoom-out-accessible-label: "Zoom out";
    in property <string> zoom-in-label: "+";
    in property <string> zoom-in-accessible-label: "Zoom in";
    in property <string> pan-page-label: "Pan page";
    in property <string> select-region-label: "Select region";
    in property <string> previous-page-label: "Previous";
    in property <string> next-page-label: "Next";
    in property <string> page-label: "Page";
    in property <string> no-page-label: "No page";
    in property <bool> viewer-busy: false;
    in property <int> page-number: 0;
    in property <int> page-count: 0;
    in property <length> image-x;
    in property <length> image-y;
    in property <length> image-width;
    in property <length> image-height;

    // Aliases to the viewport rectangle, read by dh-app when it computes the
    // fit zoom and the render size through PageTransform.
    in-out property <length> viewport-width <=> viewport.width;
    in-out property <length> viewport-height <=> viewport.height;

    // Stage 6 overlay state. The rectangle is logical viewport pixels written
    // back by dh-app from the accepted page-space selection.
    in property <bool> selection-mode: false;
    in property <bool> region-visible: false;
    in property <length> region-x: 0px;
    in property <length> region-y: 0px;
    in property <length> region-width: 0px;
    in property <length> region-height: 0px;
    in property <string> page-geometry-text: "";
    in property <string> region-page-text: "No region selected";

    callback import-pdf();
    callback previous-page();
    callback next-page();
    callback zoom-in();
    callback zoom-out();
    callback fit-page();
    callback pan(length, length);
    callback toggle-selection-mode();
    callback region-pointer-down(string, length, length);
    callback region-pointer-move(length, length);
    callback region-pointer-up(length, length);

    private property <length> last-pointer-x;
    private property <length> last-pointer-y;
    private property <bool> dragging: false;

    spacing: 8px;

    HorizontalBox {
        Button {
            text: root.import-pdf-label;
            accessible-label: root.import-pdf-accessible-label;
            enabled: root.import-pdf-enabled && !root.viewer-busy;
            clicked => { root.import-pdf(); }
        }
        Button {
            text: root.fit-page-label;
            accessible-label: root.fit-page-label;
            enabled: !root.viewer-busy;
            clicked => { root.fit-page(); }
        }
        Button {
            text: root.zoom-out-label;
            accessible-label: root.zoom-out-accessible-label;
            enabled: !root.viewer-busy;
            clicked => { root.zoom-out(); }
        }
        Button {
            text: root.zoom-in-label;
            accessible-label: root.zoom-in-accessible-label;
            enabled: !root.viewer-busy;
            clicked => { root.zoom-in(); }
        }
        Button {
            text: root.selection-mode ? root.pan-page-label : root.select-region-label;
            accessible-label: root.selection-mode ? root.pan-page-label : root.select-region-label;
            enabled: !root.viewer-busy;
            clicked => { root.toggle-selection-mode(); }
        }
        Button {
            text: root.previous-page-label;
            accessible-label: root.previous-page-label;
            enabled: root.page-number > 1 && !root.viewer-busy;
            clicked => { root.previous-page(); }
        }
        Text {
            text: root.page-count > 0
                ? root.page-label + " " + root.page-number + " / " + root.page-count
                : root.no-page-label;
            vertical-alignment: center;
        }
        Button {
            text: root.next-page-label;
            accessible-label: root.next-page-label;
            enabled: root.page-number > 0 && root.page-number < root.page-count && !root.viewer-busy;
            clicked => { root.next-page(); }
        }
    }

    viewport := Rectangle {
        min-height: 300px;
        vertical-stretch: 1;
        clip: true;
        background: #e8e8e8;

        Image {
            source: root.page-image;
            x: root.image-x;
            y: root.image-y;
            width: root.image-width;
            height: root.image-height;
            image-fit: fill;
        }

        TouchArea {
            enabled: !root.selection-mode && !root.viewer-busy;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.last-pointer-x = self.mouse-x;
                    root.last-pointer-y = self.mouse-y;
                    root.dragging = true;
                } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    root.dragging = false;
                }
            }
            moved => {
                if (root.dragging && self.pressed) {
                    root.pan(self.mouse-x - root.last-pointer-x, self.mouse-y - root.last-pointer-y);
                    root.last-pointer-x = self.mouse-x;
                    root.last-pointer-y = self.mouse-y;
                }
            }
        }

        RegionOverlay {
            active: root.selection-mode && !root.viewer-busy;
            has-selection: root.region-visible;
            rect-x: root.region-x;
            rect-y: root.region-y;
            rect-width: root.region-width;
            rect-height: root.region-height;
            region-pointer-down(kind, x, y) => { root.region-pointer-down(kind, x, y); }
            region-pointer-move(x, y) => { root.region-pointer-move(x, y); }
            region-pointer-up(x, y) => { root.region-pointer-up(x, y); }
        }
    }

    Text {
        text: root.page-geometry-text;
        wrap: word-wrap;
    }
    Text {
        text: root.region-page-text;
        wrap: word-wrap;
    }
}
