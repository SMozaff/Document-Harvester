import { AboutSlint, Button, HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";

export component AboutPanel inherits Rectangle {
    in property <string> product-name: "Document Harvester";
    in property <string> about-title-prefix: "About";
    in property <string> product-description: "Document in. Structured data out.";
    in property <string> version-label: "Version:";
    in property <string> application-version: "unknown";
    in property <string> build-label: "Build:";
    in property <string> application-build: "unknown";
    in property <string> platform-label: "Platform:";
    in property <string> application-platform: "unknown";
    in property <string> credits-licence-placeholder: "Credits and licence text: pending owner approval";
    in property <string> close-label: "Close";

    callback close();

    background: #f8fafc;
    forward-focus: about-focus;

    about-focus := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                return accept;
            }
            reject
        }

        VerticalBox {
            padding: 24px;
            spacing: 16px;

            ScrollView {
                vertical-stretch: 1;
                VerticalBox {
                    width: parent.width;
                    spacing: 16px;

                    Text {
                        text: root.about-title-prefix + " " + root.product-name;
                        font-size: 22px;
                        color: #0B2D52;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.product-description;
                        color: #64748B;
                        wrap: word-wrap;
                    }
                    VerticalBox {
                        spacing: 4px;
                        Text { text: root.version-label; color: #64748B; }
                        Text {
                            text: root.application-version;
                            horizontal-alignment: left;
                            wrap: word-wrap;
                        }
                    }
                    VerticalBox {
                        spacing: 4px;
                        Text { text: root.build-label; color: #64748B; }
                        Text {
                            text: root.application-build;
                            horizontal-alignment: left;
                            wrap: word-wrap;
                        }
                    }
                    VerticalBox {
                        spacing: 4px;
                        Text { text: root.platform-label; color: #64748B; }
                        Text {
                            text: root.application-platform;
                            horizontal-alignment: left;
                            wrap: word-wrap;
                        }
                    }
                    Text {
                        text: root.credits-licence-placeholder;
                        color: #64748B;
                        wrap: word-wrap;
                    }
                    AboutSlint {}
                }
            }

            HorizontalBox {
                alignment: end;
                Button {
                    text: root.close-label;
                    accessible-label: root.close-label;
                    clicked => { root.close(); }
                }
            }
        }
    }
}
