import { AboutSlint, Button, VerticalBox } from "std-widgets.slint";

export component AboutPanel inherits Rectangle {
    width: 420px;
    height: 220px;
    background: #f5f7fa;
    border-radius: 10px;
    border-width: 1px;
    border-color: #cbd5e1;

    callback close();

    VerticalBox {
        alignment: center;
        padding: 16px;
        spacing: 12px;

        Text {
            text: "About Document Harvester";
            font-size: 22px;
        }
        Text {
            text: "Digital PDF region capture and Excel workbook workflow";
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        AboutSlint {}
        Button {
            text: "Close";
            clicked => { root.close(); }
        }
    }
}
