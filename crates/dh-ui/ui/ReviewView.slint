import { Button, CheckBox, HorizontalBox, ListView, VerticalBox } from "std-widgets.slint";

export component ReviewView inherits VerticalBox {
    in-out property <[string]> review-rows;

    callback open-selected(int);

    VerticalBox {
        Text { text: "Review worksheet"; font-size: 16px; }
        HorizontalBox {
            Text { text: "cell"; }
            Text { text: "state"; }
            Text { text: "reason"; }
            Text { text: "raw"; }
            Text { text: "calibrated"; }
        }
        ListView {
            for row[row-index] in root.review-rows: HorizontalBox {
                Text { text: row; }
                TouchArea { clicked => { root.open-selected(row-index); } }
            }
        }
    }
}


/// Read-only capture preview. This component renders plain data and forwards
/// approval/confirmation/cancel intent; it never accesses a PDF or workbook.
export component CapturePreviewPanel inherits VerticalBox {
    in property <[string]> preview-table-ids: [];
    in property <[string]> preview-table-labels: [];
    in property <[bool]> preview-table-checked: [];
    in property <bool> selection-enabled: true;
    in property <[string]> preview-rows: [];
    in property <[string]> preview-warnings: [];
    in property <[string]> preview-unassigned: [];
    in property <string> preview-summary: "";
    in property <string> destination-label: "";
    in property <string> read-only-note: "";
    in property <int> partial-cell-count: 0;
    in property <bool> partial-confirmation-required: false;
    in property <bool> partial-confirmed: false;
    in property <bool> approve-enabled: false;
    in property <bool> cancel-enabled: true;
    in property <string> commit-label: "Approve & commit";

    // English defaults keep this component independently previewable. The
    // app-owned values above remain authoritative for data and availability.
    in property <string> title-text: "Extraction Preview";
    in property <string> source-heading: "Source and region";
    in property <string> destination-heading: "Destination workbook rows";
    in property <string> tables-heading: "Tables in this preview";
    in property <string> no-tables-note: "No reconstructed tables are available to select.";
    in property <string> rows-heading: "Preview rows";
    in property <string> no-rows-note: "Select a table to inspect its rows.";
    in property <string> warnings-heading: "Extraction warnings";
    in property <string> no-warnings-note: "No warnings were reported for the selected tables.";
    in property <string> unassigned-heading: "Unassigned text";
    in property <string> unassigned-note: "Unassigned text is recorded in the workbook’s Review sheet and is not written as a cell.";
    in property <string> no-unassigned-note: "No unassigned text was reported for the selected tables.";
    in property <string> partial-count-label: "Partial cells in selection";
    in property <string> partial-confirmation-label: "Confirm partial cells will remain blank";
    in property <string> partial-confirmed-note: "Confirmed: partial-cell text will be left blank.";
    in property <string> read-only-heading: "Read-only project";
    in property <string> cancel-label: "Cancel preview";
    in property <string> busy-note: "Commit in progress. Keep this preview open until the operation finishes.";
    in property <string> busy-label: "Committing…";
    in property <string> retry-label: "Retry commit";
    in property <string> retry-note: "The approved preview is retained. Review the application status, then retry when available.";

    callback table-selection-changed(string, bool);
    callback confirm-partial-cells();
    callback approve-preview();
    callback cancel-preview();

    spacing: 8px;

    Text {
        text: root.title-text;
        font-size: 20px;
        color: #0B2D52;
    }

    Rectangle {
        background: #f8fafc;
        border-color: #e2e8f0;
        border-width: 1px;
        border-radius: 6px;
        VerticalBox {
            padding: 8px;
            spacing: 4px;
            Text { text: root.source-heading; font-size: 14px; color: #0B2D52; }
            Text {
                text: root.preview-summary;
                wrap: word-wrap;
                color: #334155;
            }
            Text { text: root.destination-heading; font-size: 14px; color: #0B2D52; }
            Text {
                text: root.destination-label;
                wrap: word-wrap;
                color: #334155;
            }
        }
    }

    Rectangle {
        background: #ffffff;
        border-color: #e2e8f0;
        border-width: 1px;
        border-radius: 6px;
        VerticalBox {
            padding: 8px;
            spacing: 4px;
            Text { text: root.tables-heading; font-size: 15px; color: #0B2D52; }
            if root.preview-table-labels.length == 0: Text {
                text: root.no-tables-note;
                wrap: word-wrap;
                color: #64748B;
            }
            for table[table-index] in root.preview-table-labels: CheckBox {
                text: table;
                checked: root.preview-table-checked[table-index];
                enabled: root.selection-enabled;
                min-height: 36px;
                toggled => {
                    root.table-selection-changed(root.preview-table-ids[table-index], self.checked);
                }
            }
        }
    }

    Rectangle {
        background: #f8fafc;
        border-color: #e2e8f0;
        border-width: 1px;
        border-radius: 6px;
        VerticalBox {
            padding: 8px;
            spacing: 4px;
            HorizontalBox {
                Text { text: root.partial-count-label; color: #334155; }
                Text { text: root.partial-cell-count; color: #0B2D52; }
            }
            if root.partial-confirmation-required: Button {
                text: root.partial-confirmation-label;
                enabled: root.selection-enabled;
                min-height: 40px;
                clicked => { root.confirm-partial-cells(); }
            }
            if root.partial-confirmed: Text {
                text: root.partial-confirmed-note;
                wrap: word-wrap;
                color: #0B2D52;
            }
        }
    }

    if root.read-only-note != "": Rectangle {
        background: #f1f5f9;
        border-color: #cbd5e1;
        border-width: 1px;
        border-radius: 6px;
        VerticalBox {
            padding: 8px;
            spacing: 3px;
            Text { text: root.read-only-heading; font-size: 14px; color: #0B2D52; }
            Text { text: root.read-only-note; wrap: word-wrap; color: #334155; }
        }
    }

    Rectangle {
        background: #ffffff;
        border-color: #e2e8f0;
        border-width: 1px;
        border-radius: 6px;
        VerticalBox {
            padding: 8px;
            spacing: 4px;
            Text { text: root.rows-heading; font-size: 15px; color: #0B2D52; }
            if root.preview-rows.length == 0: Text {
                text: root.no-rows-note;
                wrap: word-wrap;
                color: #64748B;
            }
            ListView {
                height: 104px;
                for row in root.preview-rows: Text {
                    text: row;
                    wrap: word-wrap;
                    color: #334155;
                }
            }
        }
    }

    Rectangle {
        background: #f1f5f9;
        border-color: #cbd5e1;
        border-width: 1px;
        border-radius: 6px;
        VerticalBox {
            padding: 8px;
            spacing: 4px;
            Text { text: root.warnings-heading; font-size: 15px; color: #0B2D52; }
            if root.preview-warnings.length == 0: Text {
                text: root.no-warnings-note;
                wrap: word-wrap;
                color: #64748B;
            }
            ListView {
                height: 88px;
                for warning in root.preview-warnings: Text {
                    text: warning;
                    wrap: word-wrap;
                    color: #334155;
                }
            }
        }
    }

    Rectangle {
        background: #f8fafc;
        border-color: #e2e8f0;
        border-width: 1px;
        border-radius: 6px;
        VerticalBox {
            padding: 8px;
            spacing: 4px;
            Text { text: root.unassigned-heading; font-size: 15px; color: #0B2D52; }
            Text { text: root.unassigned-note; wrap: word-wrap; color: #64748B; }
            if root.preview-unassigned.length == 0: Text {
                text: root.no-unassigned-note;
                wrap: word-wrap;
                color: #64748B;
            }
            ListView {
                height: 88px;
                for item in root.preview-unassigned: Text {
                    text: item;
                    wrap: word-wrap;
                    color: #334155;
                }
            }
        }
    }

    if root.commit-label == root.retry-label: Text {
        text: root.retry-note;
        wrap: word-wrap;
        color: #64748B;
    }
    if root.commit-label == root.busy-label: Text {
        text: root.busy-note;
        wrap: word-wrap;
        color: #64748B;
    }

    HorizontalBox {
        alignment: space-between;
        Button {
            text: root.commit-label;
            enabled: root.approve-enabled;
            min-height: 44px;
            clicked => { root.approve-preview(); }
        }
        Button {
            text: root.cancel-label;
            enabled: root.cancel-enabled;
            min-height: 44px;
            clicked => { root.cancel-preview(); }
        }
    }
}
