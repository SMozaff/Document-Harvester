import { HorizontalBox, ListView, Text, TouchArea, VerticalBox } from "std-widgets.slint";

export component ReviewView inherits VerticalBox {
    in-out property <[string]> review-rows;

    callback open-selected(int);

    VerticalBox {
        Text { text: "Review worksheet"; font-size: 16px; }
        HorizontalBox {
            Text { text: "cell"; }
            Text { text: "state"; }
            Text { text: "reason"; }
            Text { text: "raw"; }
            Text { text: "calibrated"; }
        }
        ListView {
            for row in root.review-rows: HorizontalBox {
                Text { text: row; }
                TouchArea { clicked => { root.open-selected(index); } }
            }
        }
    }
}
