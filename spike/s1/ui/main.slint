import "../../../data/validated_fonts/Vazirmatn-Regular.ttf";
import { Button, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "S-1 Locale Feasibility — Segmented Composition";
    preferred-width: 720px;
    preferred-height: 520px;
    min-width: 720px;
    min-height: 520px;
    background: #f8fafc;
    default-font-family: "Vazirmatn";

    in-out property <bool> locale-fa: false;
    in-out property <int> screen-state-token: 7;
    in-out property <string> path-value: "C:\\Users\\Mahsa\\Documents\\Project Files\\Localization\\Captured Tables\\Q4\\quarterly-2026-11-28-extraction-results.xlsx";

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        Text {
            text: "S-1 Locale Feasibility — Slint 1.19.0";
            font-size: 20px;
            color: #0B2D52;
            vertical-alignment: center;
        }

        HorizontalBox {
            height: 44px;
            spacing: 8px;
            Button {
                text: root.locale-fa ? "افزودن به وضعیت صفحه" : "Increment screen state";
                accessible-label: root.locale-fa ? "افزودن به وضعیت صفحه" : "Increment screen state";
                clicked => { root.screen-state-token += 1; }
            }
            Button {
                text: root.locale-fa ? "تغییر زبان به English" : "Switch locale to فارسی";
                accessible-label: root.locale-fa ? "تغییر زبان به English" : "Switch locale to Persian";
                clicked => { root.locale-fa = !root.locale-fa; }
            }
        }

        Text {
            text: root.locale-fa ? "وضعیت صفحه حفظ‌شده: " + root.screen-state-token : "Preserved screen-state token: " + root.screen-state-token;
            horizontal-alignment: root.locale-fa ? right : left;
            color: #0B2D52;
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalBox {
                spacing: 10px;

                Text {
                    text: root.locale-fa ? "جملهٔ بخش‌بندی‌شده — از راست به چپ بخوانید:" : "Segmented sentence — read Persian from right to left:";
                    color: #0B2D52;
                    font-size: 16px;
                    horizontal-alignment: root.locale-fa ? right : left;
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: stretch;

                    // HorizontalLayout keeps physical child order. For Persian,
                    // put the trailing prose at the left so reading right-to-left
                    // encounters prefix, LTR path, then suffix.
                    if root.locale-fa: Text {
                        text: " را برای بررسی انتخاب کنید.";
                        width: 128px;
                        wrap: word-wrap;
                        horizontal-alignment: right;
                        vertical-alignment: top;
                    }
                    if root.locale-fa: Text {
                        text: root.path-value;
                        width: 420px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                        vertical-alignment: top;
                        accessible-label: root.path-value;
                        color: #0B2D52;
                    }
                    if root.locale-fa: Text {
                        text: "سند ";
                        width: 124px;
                        wrap: word-wrap;
                        horizontal-alignment: right;
                        vertical-alignment: top;
                    }

                    if !root.locale-fa: Text {
                        text: "Select document ";
                        width: 124px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                        vertical-alignment: top;
                    }
                    if !root.locale-fa: Text {
                        text: root.path-value;
                        width: 420px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                        vertical-alignment: top;
                        accessible-label: root.path-value;
                        color: #0B2D52;
                    }
                    if !root.locale-fa: Text {
                        text: " for review.";
                        width: 128px;
                        wrap: word-wrap;
                        horizontal-alignment: left;
                        vertical-alignment: top;
                    }
                }

                Text {
                    text: root.locale-fa ? "مقدار کامل مسیر در یک عنصر مستقل LTR:" : "Full path value in its own LTR element:";
                    color: #64748B;
                    horizontal-alignment: root.locale-fa ? right : left;
                }
                Text {
                    text: root.path-value;
                    accessible-label: root.path-value;
                    horizontal-alignment: left;
                    wrap: word-wrap;
                    font-size: 14px;
                }

                Text {
                    text: root.locale-fa ? "نام فایل و اعداد: quarterly-2026-11-28.xlsx | نسخه 2.4.0 | شناسه CAP-002" : "Filename and numbers: quarterly-2026-11-28.xlsx | version 2.4.0 | identifier CAP-002";
                    horizontal-alignment: root.locale-fa ? right : left;
                    wrap: word-wrap;
                }

                Text {
                    text: root.locale-fa ? "این متن طولانی فارسی برای بررسی شکل‌دهی حروف، پوشش نویسه‌ها، راست‌چین بودن و پیچیدن سطرها در پنجرهٔ کوچک آزمایشی نوشته شده است. تغییر زبان فقط متن‌ها را به‌روزرسانی می‌کند و مقدار وضعیت صفحه حفظ می‌شود." : "This deliberately long Persian paragraph checks shaping, glyph coverage, right alignment and wrapping in the small test window. Switching locale updates text while preserving the screen-state token.";
                    horizontal-alignment: root.locale-fa ? right : left;
                    wrap: word-wrap;
                }

                Text {
                    text: root.locale-fa ? "شناسهٔ فنی LTR: DOC-FA-2026-11-28-A17" : "Technical identifier (LTR): DOC-FA-2026-11-28-A17";
                    horizontal-alignment: left;
                    wrap: word-wrap;
                }
            }
        }

        Text {
            text: root.locale-fa ? "اندازهٔ پنجره: 720 × 520 — Vazirmatn Regular" : "Window: 720 × 520 — Vazirmatn Regular";
            color: #64748B;
            horizontal-alignment: root.locale-fa ? right : left;
        }
    }
}
